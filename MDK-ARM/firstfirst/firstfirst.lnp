--cpu Cortex-M3
"firstfirst\startup_stm32f103xb.o"
"firstfirst\main.o"
"firstfirst\stm32f1xx_it.o"
"firstfirst\stm32f1xx_hal_msp.o"
"firstfirst\stm32f1xx_hal_gpio_ex.o"
"firstfirst\stm32f1xx_hal.o"
"firstfirst\stm32f1xx_hal_rcc.o"
"firstfirst\stm32f1xx_hal_rcc_ex.o"
"firstfirst\stm32f1xx_hal_gpio.o"
"firstfirst\stm32f1xx_hal_dma.o"
"firstfirst\stm32f1xx_hal_cortex.o"
"firstfirst\stm32f1xx_hal_pwr.o"
